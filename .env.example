APP_ENV=debug # debug | staging | release
API_BASE_URL=https://api-dev.example.com

# Google Sign-In v7 — required on Android
GOOGLE_SERVER_CLIENT_ID=123abcd-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Tạo API key tại: https://resend.com/api-keys
# Verify domain tại: https://resend.com/domains (hoặc dùng onboarding@resend.dev để test)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Gmail SMTP — dùng tạm khi chưa verify domain Resend
# App Password: myaccount.google.com/apppasswords (cần bật 2FA trước)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD='your-app-password'

# OneSignal App ID (Settings > Keys & IDs).
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
NOTIFY_WEBHOOK_URL=https://your-deployment.vercel.app/api

FIREBASE_SERVICE_ACCOUNT_JSON={
    "type": "service_account",
    "project_id": "askme-humg-app",
    "private_key_id": "your-private-key-id",
    "private_key": "your-private-key",
    "client_email": "your-client-email",
    "client_id": "your-client-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-client-email"
}
APP_ENV=debug # debug | staging | release
API_BASE_URL=https://api-dev.example.com

# Google Sign-In v7 — required on Android
GOOGLE_SERVER_CLIENT_ID=123abcd-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Tạo API key tại: https://resend.com/api-keys
# Verify domain tại: https://resend.com/domains (hoặc dùng onboarding@resend.dev để test)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Gmail SMTP — dùng tạm khi chưa verify domain Resend
# App Password: myaccount.google.com/apppasswords (cần bật 2FA trước)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD='your-app-password'